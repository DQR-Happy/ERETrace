+// cuLaunchKernel probe path. Preserve the driver's semantics for attributed
+// launches and the default stream.
+static CUresult launch_kernel_ex_common(
+    const CUlaunchConfig* config, CUfunction f, void** kernelParams,
+    void** extra,
+    CUresult (*real_launch)(const CUlaunchConfig*, CUfunction, void**, void**),
+    const char* api_name) {
+    if (shared_lib == NULL) { init(); }
+    if (config == NULL) return CUDA_ERROR_INVALID_VALUE;
+    if(ar_external_depth)return real_launch(config,f,kernelParams,extra);
+    AB_LOG("[exec] enter %s attrs=%u stream=%p\n", api_name,
+            config->numAttrs, (void*)config->hStream);
+    AB_FLUSH();
+    if (config->numAttrs == 0 &&
+        (config->hStream != NULL || strcmp(api_name, "cuLaunchKernelEx") == 0)) {
+        AB_LOG("[exec] route %s to cuLaunchKernel\n", api_name);
+        AB_FLUSH();
+        return cuLaunchKernel(f, config->gridDimX, config->gridDimY,
+                              config->gridDimZ, config->blockDimX,
+                              config->blockDimY, config->blockDimZ,
+                              config->sharedMemBytes, config->hStream,
+                              kernelParams, extra);
+    }
+    nt_span timing = nt_begin(f);
+    NT_STAGE(ORIGINAL_SUBMIT);
+    CUresult rc = real_launch(config, f, kernelParams, extra);
+    nt_finish(&timing, NT_BYPASS, rc != CUDA_SUCCESS);
+    return rc;
+}
