+def _instruction_matches(line: str, position: str) -> bool:
+    # Match an opcode, never a comment, declaration, label, or operand name.
+    code = line.split("//", 1)[0].strip()
+    match = re.match(r"(?:@[!]?%[\w$]+\s+)?([a-z][\w.]*)\s*(?:;|\s)", code + " ")
+    if not match or ";" not in code:
+        return False
+    opcode = match.group(1)
+    wanted = position.rstrip(";")
+    return opcode == wanted or opcode.startswith(wanted + ".")
+
+
